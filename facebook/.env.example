# ==========================================
# CẤU HÌNH SOCIAL LISTENER V3.0 (100% RUST)
# ==========================================

# Cổng lắng nghe REST API & Metrics
PORT=8000
HOST=0.0.0.0

# CSDL (SQLite hoặc MySQL 8.4+)
# SQLite: sqlite://social_listener.db?mode=rwc
# MySQL: mysql://social_user:secret_password@mysql:3306/social_listener
DATABASE_URL=sqlite://social_listener.db?mode=rwc

# Đường dẫn binary facebook-cli và runtime profile
FB_BIN_PATH=./bin/fb
CHROME_PROFILE_DIR=./runtime/profile
FB_TIMEOUT=300

# Chu kỳ quét mặc định cho mỗi nhóm (giây, có jitter ±5%)
CRAWL_INTERVAL_SECONDS=300

# Số lượng bài viết tối đa mỗi lượt quét (10 bài khi chu kỳ quét 25-30 phút)
MAX_POSTS_PER_CRAWL=10

# ========================================================
# TẦNG 2 AI GATEWAY: GROQ (PRIMARY) + GEMINI (BACKUP)
# ========================================================
# Groq API Key: Lấy tại https://console.groq.com/keys
GROQ_API_KEY=disabled
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_QWEN_MODEL=qwen/qwen3.6-27b

# Google Gemini API Key (Backup khi toàn bộ model Groq bận hoặc lỗi)
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=disabled
GEMINI_MODEL=gemini-1.5-flash

# Tích hợp CRM Tổ Kiến (Anthill.Api Webhook)
TO_KIEN_WEBHOOK_URL=http://host.docker.internal:8080/api/v1/webhooks/social-leads
TO_KIEN_TOKEN=to_kien_secret_bearer_token
